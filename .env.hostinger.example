# Copy values into Hostinger's environment-variable settings; never commit real secrets.
NODE_ENV=production
APP_BASE_URL=https://app.example.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_hpanel_database_name
DB_USER=replace_with_hpanel_database_user
DB_PASSWORD=replace_with_database_password
DB_POOL_MAX=4
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Use your actual account path, outside public_html and hbuilds. Copy existing uploads here.
UPLOAD_DIR=/home/replace_account/domains/app.example.com/app-data/uploads

# Enable only after importing and verifying the database INCLUDING SequelizeMeta.
RUN_MIGRATIONS=false
# These services are optional. Docker service names cannot resolve on managed hosting.
REDIS_ENABLED=false
AMQP_ENABLED=false
LICENSE_EXPIRY_JOB_ENABLED=true

# Mail delivery uses SMTP2GO's API, not SMTP login credentials.
SMTP2GO_API_KEY=replace_with_smtp2go_api_key
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Biz Assistant
# Leave PORT unset unless Hostinger explicitly provides/requires it.
