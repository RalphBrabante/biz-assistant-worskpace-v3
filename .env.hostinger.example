# Copy values into Hostinger's environment-variable settings; never commit real secrets.
NODE_ENV=production
APP_BASE_URL=https://app.example.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_hpanel_database_name
DB_USER=replace_with_hpanel_database_user
DB_PASSWORD=replace_with_database_password
DB_POOL_MAX=4
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# REQUIRED: replace replace_account AND app.example.com with your actual hosting account/domain.
# Find these in the /home/u.../domains/.../hbuilds path in deployment logs.
# Create this writable directory outside public_html and hbuilds; copy existing uploads here.
UPLOAD_DIR=/home/replace_account/domains/app.example.com/app-data/uploads

# Enable only after importing and verifying the database INCLUDING SequelizeMeta.
RUN_MIGRATIONS=false
# These services are optional. Docker service names cannot resolve on managed hosting.
REDIS_ENABLED=false
# API response caching automatically uses server memory without Redis.
API_CACHE_TTL_SECONDS=60
API_CACHE_MAX_ENTRIES=500
API_CACHE_MAX_BYTES=33554432
API_CACHE_MAX_ENTRY_BYTES=1048576
AMQP_ENABLED=false
LICENSE_EXPIRY_JOB_ENABLED=true

# Mail delivery uses SMTP2GO's API, not SMTP login credentials.
SMTP2GO_API_KEY=replace_with_smtp2go_api_key
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Biz Assistant
# Leave PORT unset unless Hostinger explicitly provides/requires it.

# Gmail email tickets (separate from Google Drive storage)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Defaults to APP_BASE_URL + /api/v1/tickets/gmail/callback
GMAIL_REDIRECT_URI=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_ENABLED=true

# Hostinger/Titan mailbox passwords are entered per organization in Email tickets.
# One server-wide encryption key protects stored passwords (64 hex characters).
EMAIL_TICKET_ENCRYPTION_KEY=
EMAIL_TICKET_SYNC_ENABLED=true
