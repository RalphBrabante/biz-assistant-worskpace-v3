MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Production tuning (recommended baseline for 1 vCPU hosts)
DB_POOL_MAX=4
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=20000
DB_POOL_IDLE_MS=5000
DB_POOL_EVICT_MS=1000
DB_CONNECT_TIMEOUT_MS=20000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOG_SQL=false
REDIS_CONNECT_TIMEOUT_MS=10000
JSON_BODY_LIMIT=1mb
HTTP_KEEPALIVE_TIMEOUT_MS=5000
HTTP_HEADERS_TIMEOUT_MS=6000
HTTP_REQUEST_TIMEOUT_MS=30000
RABBITMQ_VM_MEMORY_HIGH_WATERMARK=0.25
RABBITMQ_DISK_FREE_LIMIT=200MB

# Auth/Email
APP_NAME=Biz Assistant
APP_BASE_URL=http://localhost
RESET_PASSWORD_PATH=/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30
VERIFY_EMAIL_PATH=/verify-email
VERIFY_EMAIL_EXPIRES_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Biz Assistant
SMTP_FROM_EMAIL=no-reply@bizassistant.local
# Required for email sending in all environments (dev and prod).
SMTP2GO_API_KEY=
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
